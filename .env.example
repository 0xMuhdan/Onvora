# ONVORA — Environment Configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`.

# PostgreSQL connection string (DEC-016)
DATABASE_URL="postgresql://onvora:onvora@localhost:5432/onvora"

# SMTP OTP / magic-link delivery (DEC-017)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="no-reply@onvora.id"
SMTP_PASSWORD=""
SMTP_FROM="Onvora Gazette <no-reply@onvora.id>"

# Session signing secret (32+ random bytes, hex)
SESSION_SECRET=""

# Public base URL used for verification links and credential URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Multi-chain adapter (ONV-28) — Ethereum Sepolia testnet RPC
ETHEREUM_SEPOLIA_RPC_URL="https://rpc.sepolia.org"
